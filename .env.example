# Copiá este archivo como .env para cambiar los valores por defecto.
# Compose lo lee solo; ninguna variable es obligatoria.

# --- simulation-service -------------------------------------------------------------------
# Cantidad de réplicas detrás de Traefik.
SIMULATION_REPLICAS=3
# Simulaciones simultáneas por réplica. El cálculo usa CPU y cada réplica tiene 1 CPU.
MAX_CONCURRENT=1
# Segundos de espera en la cola antes de responder 503. Debe ser menor que
# SIMULATION_TIMEOUT_SECONDS para que circuit-service reciba el 503 y no un timeout.
QUEUE_TIMEOUT_SECONDS=10
# Valor del header Retry-After ante saturación.
RETRY_AFTER_SECONDS=1
# Máximo de componentes por circuito (413 too_large). Lo aplican los dos servicios.
MAX_COMPONENTS=20000
# Rate limit de Traefik en /simulate, por IP de cliente (pedidos por segundo y ráfaga).
# Ojo: las simulaciones de circuit-service también pasan por acá y cuentan como un solo cliente.
SIMULATE_RATE_LIMIT_AVERAGE=100
SIMULATE_RATE_LIMIT_BURST=200

# --- circuit-service ----------------------------------------------------------------------
# Timeout de las llamadas a /simulate.
SIMULATION_TIMEOUT_SECONDS=30
# Rate limit de Traefik en /api/circuits y /health, por IP de cliente.
CIRCUITS_RATE_LIMIT_AVERAGE=50
CIRCUITS_RATE_LIMIT_BURST=100
